Algoritmo "Positivo, negativo ou zero do Rafael Reis RA02610314"
// Lê um número e mostra se é positivo, negativo ou zero
Var

n : real

Inicio

escreva ("Digite um valor: ")
leia (n)

se n > 0 entao
escreval ("Esse número é positivo")
fimse

se n = 0 entao
escreval ("Esse número é zero")
fimse

se n < 0 entao
escreval ("Esse número é negativo")
fimse

Fimalgoritmo