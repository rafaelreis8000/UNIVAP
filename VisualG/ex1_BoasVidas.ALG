Algoritmo "Apresentação do Rafael Reis RA 02610314"
// Faz a leitura de dois números e mostre a soma, a subtração e a multiplicação
Var

nome : caractere
idade : inteiro
Inicio

escreva ("Informe o seu nome: ")
leia (nome)
escreva ("Informe a sua idade: ")
leia (idade)

escreval ("Seja bem-vindo(a), " , nome , ". Sua idade é ", idade)

Fimalgoritmo